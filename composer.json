{
    "name": "riftweb/superseeder",
    "description": "Migration-style execution tracking and safe rollbacks for Laravel seeders.",
    "license": "MIT",
    "keywords": [
        "riftweb",
        "laravel",
        "database seeder",
        "seeder tracking",
        "rollback seeders",
        "database migrations",
        "batch seeding",
        "laravel package",
        "database seeding",
        "migration-like seeders",
        "seed management"
        "seeder rollback"
    ],
    "authors": [
        {
            "name": "Leandro Santos",
            "email": "geral@riftweb.com",
            "homepage": "https://riftweb.com",
            "role": "CEO"
        }
    ],
    "homepage": "https://github.com/riftwebdev/superseeder",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Riftweb\\SuperSeeder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riftweb\\SuperSeeder\\Providers\\RiftSuperSeederServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --ci",
        "format": "pint"
    }
}